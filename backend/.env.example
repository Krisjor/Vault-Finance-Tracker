# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production-please

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_tracker
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/finance_tracker_test

# JWT
JWT_SECRET_KEY=change-this-jwt-secret-too
JWT_ACCESS_TOKEN_EXPIRES_HOURS=1
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# CORS
FRONTEND_URL=http://localhost:5173

# Defaults
DEFAULT_CURRENCY=ALL
